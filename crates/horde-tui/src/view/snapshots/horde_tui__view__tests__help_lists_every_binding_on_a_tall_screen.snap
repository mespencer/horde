" horde  1:session  2:agents  3:inbox  4:workspaces  5:usage  6:logs  7:forwards "
"                                                                                "
" Session (compose box)                                                          "
"   alt-enter      new line                                                      "
"   shift-enter    new line                                                      "
"   ctrl-j         new line                                                      "
"   enter          send, or run a /command                                       "
"   esc            interrupt a working agent · close · back                      "
"   tab            complete a command · switch prompt/compose                    "
"   ctrl-s         send now (interrupts the turn)                                "
"   ctrl-x         interrupt the agent's turn                                    "
"   ctrl-d         quit                                                          "
"   ctrl-a         line start                                                    "
"   ctrl-e         line end                                                      "
"   ctrl-w         delete a word                                                 "
"   ctrl-u         delete to line start                                          "
"   backspace      edit                                                          "
"   delete         edit                                                          "
"   left           edit                                                          "
"   right          edit                                                          "
"   up             move up · older message                                       "
"   down           move down · newer message                                     "
"   home           line start                                                    "
"   end            line end                                                      "
"   ctrl-end       back to the latest                                            "
" Prompt card                                                                    "
"   up             choose · answer                                               "
"   down           choose · answer                                               "
"   left           choose · answer                                               "
"   right          choose · answer                                               "
"   enter          choose · answer                                               "
"   space          choose · answer                                               "
"   backspace      choose · answer                                               "
"   tab            complete a command · switch prompt/compose                    "
"   esc            interrupt a working agent · close · back                      "
"   ctrl-x         interrupt the agent's turn                                    "
" Everywhere                                                                     "
"   ctrl-c         clear the compose box, or quit                                "
"   ctrl-t         open agents                                                   "
"   ctrl-o         expand or collapse tool detail                                "
"   alt-1          open the session                                              "
"   alt-2          open agents                                                   "
"   alt-3          open the inbox                                                "
"   alt-4          open workspaces                                               "
"   alt-5          open usage                                                    "
"   alt-6          open logs                                                     "
"   alt-7          open forwards                                                 "
"   f1             open help                                                     "
"   pgup           scroll the transcript back                                    "
"   pgdn           scroll the transcript forward                                 "
" Lists                                                                          "
"   up             move the selection                                            "
"   k              move the selection                                            "
"   down           move the selection                                            "
"   j              move the selection                                            "
"   enter          attach · open                                                 "
"   esc            interrupt a working agent · close · back                      "
"   q              quit                                                          "
"   r              refresh                                                       "
"   n              new session                                                   "
"   x              archive the session (asks first)                              "
"   s              open the session                                              "
"   o              open agents                                                   "
"   a              open agents                                                   "
"   i              open the inbox                                                "
"   w              open workspaces                                               "
"   u              open usage                                                    "
"   l              open logs                                                     "
"   f              open forwards                                                 "
"   ?              open help                                                     "
" Commands                                                                       "
"   /attach [session|agent]   attach to a session or agent; alone, pick from the "
"   /new [title]           start a new session and attach to it                  "
"   /agents                   sessions and their agent trees                     "
"   /inbox                   everything waiting on you, across sessions          "
"   /workspaces                   workspace definitions, instances and checkouts "
"   /usage                   token usage by agent, tree and account              "
"   /logs                   worker and server logs                               "
"   /forwards                   port forwards and who backs them                 "
"   /interrupt                   cancel the agent's current turn                 "
"   /now <message>         interrupt and deliver a message immediately           "
"   /note <message>         send a note the agent reads without replying         "
"   /details                   show or hide full tool input and output           "
"   /archive [session]         archive the attached session (asks first)         "
"   /help                   keys and commands                                    "
"   /quit                   leave the TUI (the session keeps running)            "
