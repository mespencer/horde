/target
/.claude/worktrees/
**/*.log
/gen/
/spikes/*/target/
/scratch/
/mutants.out/
**/mutants.out/
# cargo-mutants rotates the previous run's output aside rather than deleting it,
# so the debris of a hand-run comes in pairs.
/mutants.out.old/
**/mutants.out.old/
# insta writes pending snapshots beside the committed ones; only the
# accepted .snap files belong in the tree.
*.snap.new
*.pending-snap
